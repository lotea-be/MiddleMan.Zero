{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "dotnet",
			"task": "build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"label": "dotnet: build"
		},
		{
			"label": "build-api-net8.0",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/samples/IceCreamTruck.WebApi/IceCreamTruck.WebApi.csproj",
				"--framework",
				"net8.0",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "build-api-net9.0",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/samples/IceCreamTruck.WebApi/IceCreamTruck.WebApi.csproj",
				"--framework",
				"net9.0",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "build-api-net10.0",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/samples/IceCreamTruck.WebApi/IceCreamTruck.WebApi.csproj",
				"--framework",
				"net10.0",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "upgrade-dependencies-net8.0",
			"type": "shell",
			"command": "dotnet outdated --upgrade --target-framework net8.0",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "upgrade-dependencies-net9.0",
			"type": "shell",
			"command": "dotnet outdated --upgrade --exclude Swashbuckle.AspNetCore --target-framework net9.0",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "upgrade-dependencies-net10.0",
			"type": "shell",
			"command": "dotnet outdated --upgrade --target-framework net10.0",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "upgrade-dependencies",
			"dependsOn": [
				"dotnet outdated -U -i",
				"upgrade-dependencies-net9.0",
				"upgrade-dependencies-net10.0"
			],
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
            "label": "test",
            "dependsOn": [],
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/MiddleMan.Zero.sln",
                "--settings",
                "${workspaceFolder}/coverlet.runsettings"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "coverage-report",
            "type": "shell",
            "command": "reportgenerator -reports:'tests/**/coverage.opencover.xml' -targetdir:'coverage-report' -reporttypes:'Html;TextSummary' \"-classfilters:-Microsoft.AspNetCore.OpenApi.Generated*;-System.Runtime.CompilerServices*\"",
            "dependsOn": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "coverage-serve",
            "type": "shell",
            "command": "fuser -k 8080/tcp 2>/dev/null; sleep 0.3; python3 -m http.server 8080 --directory ${workspaceFolder}/coverage-report",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    { "regexp": "^$", "file": 1, "location": 2, "message": 3 }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving HTTP",
                    "endsPattern": "^Serving HTTP"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "coverage",
            "dependsOn": ["coverage-report", "coverage-serve"],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": "test"
        }
	]
}