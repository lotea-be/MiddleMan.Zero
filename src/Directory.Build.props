<Project>

    <Import
        Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
        Condition="'' != $([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <!-- Centralized version for all MiddleMan.Zero NuGet packages -->
        <Version>0.1.0</Version>
        <PackageVersion>$(Version)</PackageVersion>

        <!-- Optional: Additional NuGet package metadata -->
        <Authors>braekstuv</Authors>
        <Company>braekstuv</Company>
        <Copyright>Copyright © $(Authors) $([System.DateTime]::Now.Year)</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/braekstuv/MiddleMan.Zero</PackageProjectUrl>
        <RepositoryUrl>https://github.com/braekstuv/MiddleMan.Zero</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>mediator;cqrs;messaging;handler</PackageTags>
        <Description>A lightweight mediator pattern implementation for .NET</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>